# Supabase project (same project the SVAR AI app uses)
NEXT_PUBLIC_SUPABASE_URL=https://tjhuexhsadigbqbxnxkd.supabase.co

# Anon/publishable key — safe in the browser, protected by RLS.
# Supabase Dashboard > Project Settings > API keys > anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, NEVER expose to the browser or commit.
# Supabase Dashboard > Project Settings > API keys > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Flask AI service (transcription + rewrites). Server-only: the browser talks
# to /api/ai/* on this app, which proxies here with the user's Supabase JWT.
AI_API_URL=https://svar-ai-flask.onrender.com

# Public origin, used to build OAuth and magic-link redirect URLs.
# Marketing (Cloudflare Pages): https://svarai.com
# Web app (Render): https://app.svarai.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# RevenueCat Web Billing public key (optional). Leave blank to hide web checkout.
# RevenueCat Dashboard > Project Settings > API keys > Web.
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
